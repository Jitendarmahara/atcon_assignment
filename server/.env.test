# Used only by vitest.config.ts - a dedicated test database on the same
# docker-compose postgres, and a separate Redis logical DB (index 1) so test
# runs never touch dev/demo data.
DATABASE_URL="postgresql://ats:ats@localhost:5433/ats_test?schema=public"
SCOPED_DATABASE_URL="postgresql://ats_app:ats_app_password_dev_only@localhost:5433/ats_test?schema=public"
REDIS_URL="redis://localhost:6380/1"
JWT_ACCESS_SECRET="test-access-secret-not-for-prod-use"
JWT_REFRESH_SECRET="test-refresh-secret-not-for-prod-use"
SMTP_HOST="localhost"
SMTP_PORT=1025
WEB_ORIGIN="http://localhost:5173"
STORAGE_DIR="./storage/resumes-test"
