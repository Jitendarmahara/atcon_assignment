# Copy to .env and adjust as needed. Defaults match docker-compose.yml.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://ats:ats@localhost:5433/ats?schema=public"
# Same database, connected as the `ats_app` role Postgres Row-Level Security
# actually restricts (created by migration 20260829213000_row_level_security)
# - used for every authenticated request. See config/env.ts.
SCOPED_DATABASE_URL="postgresql://ats_app:ats_app_password_dev_only@localhost:5433/ats?schema=public"
REDIS_URL="redis://localhost:6380"

# HS256 secrets - generate real random values for anything beyond local dev.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# SMTP - defaults point at the mailhog container, no auth required.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="ATS Platform <no-reply@ats.local>"

# Local disk storage for resumes (StorageAdapter). Swap for an S3 adapter in production.
STORAGE_DIR="./storage/resumes"
MAX_UPLOAD_MB=10

# Public web app origin, for CORS + generated links in emails.
WEB_ORIGIN="http://localhost:5173"

# Resume parsing is LLM-only - one of these two is required for it to work
# at all (every upload fails clearly, not silently, if both are unset).
# DEEPSEEK_API_KEY is checked first when both happen to be set.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
